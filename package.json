  "exports": {
    ".": "./index.ts"
  },
  "main": "./index.ts",
  "files": [
    "index.ts",
    "lib.ts"
  ],
  "keywords": [
    "opencode",
    "plugin",
    "vision",
    "image",
    "vlm",
    "accessibility",
    "multimodal",
    "text-only"
  ],
  "license": "MIT",
  "author": "Martin Mose Facondini",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinmose/opencode-vision-bridge.git"
  },
  "homepage": "https://github.com/martinmose/opencode-vision-bridge#readme",
  "bugs": {
    "url": "https://github.com/martinmose/opencode-vision-bridge/issues"
  },
  "scripts": {
    "prepublishOnly": "tsc --noEmit && node --test tests/vision-bridge.test.ts"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
