# Per-developer config + secret. Gitignored; sourced by the flox on-activate
# hook so OpenCode inherits these. Copy to .env and fill in your own values.
#
# All fields below are optional — defaults are shown. You only need to set
# VISION_API_KEY (or ZELDOC_API_KEY if that's already in your environment).

# --- Required in practice (no sensible default for the secret) ---
VISION_API_KEY=replace-me

# --- Endpoint & model ---
VISION_BASE_URL=https://api.zeldoc.ai/v1
VISION_MODEL=zeldoc/gemma-4-31B

# --- Behavior ---
VISION_QUESTION=Describe this image in detail.
VISION_TIMEOUT=60000
VISION_RETRY_DELAY_MS=1000
VISION_MAX_CONCURRENCY=3
VISION_MAX_TOKENS=1024
VISION_PREFIX=[Image description]\n
VISION_CACHE_SIZE=100

# --- Skip vision-capable providers (comma-separated, or "none") ---
VISION_SKIP_PROVIDERS=anthropic,openai,google,vertex,bedrock,xai,azure

# --- Only process specific models (comma-separated, provider/model format) ---
# When set, takes priority over VISION_SKIP_PROVIDERS.
# VISION_ENABLE_MODELS=zeldoc/z-code

# --- Debug logging (1 = enabled) ---
# VISION_DEBUG=1
